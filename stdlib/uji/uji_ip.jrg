package main
import "std/ip"

fn p(s) { return ip::parse(s).unwrap() }
fn galat(s) { return ip::parse(s).unwrap_err() }

fn test_bentuk_kanonik() {
    assert_eq(ip::format(p("192.0.2.1")), "192.0.2.1")
    assert_eq(ip::format(p("2001:0DB8:0000:0000:0000:0000:0000:0001")), "2001:db8::1")
    assert_eq(ip::format(p("::")), "::")
    assert_eq(ip::format(p("1:0:0:2:0:0:0:3")), "1:0:0:2::3")
    assert_eq(ip::format(p("1:0:2:3:4:5:6:7")), "1:0:2:3:4:5:6:7")
    assert_eq(ip::format(p("::ffff:7f00:1")), "::ffff:127.0.0.1")
    assert_eq(ip::format(p("1:2:3:4:5:6:1.2.3.4")), "1:2:3:4:5:6:102:304")
}

fn test_ejaan_kedua_ditolak() {
    assert_eq(galat("010.0.0.1"), "alamat IP `010.0.0.1`: bagian ke-1 berawalan nol — dibaca oktal oleh sebagian pengurai")
    assert_eq(galat("127.1"), "alamat IP `127.1`: IPv4 harus tepat empat bagian bertitik (bentuk pendek seperti `127.1` ditolak)")
    assert_eq(galat("0x7f.0.0.1"), "alamat IP `0x7f.0.0.1`: bagian ke-1 bukan bilangan desimal 0 sampai 255")
    assert_eq(galat("256.0.0.1"), "alamat IP `256.0.0.1`: bagian ke-1 (256) di atas 255")
    assert_eq(galat("2130706433"), "alamat IP `2130706433`: IPv4 harus tepat empat bagian bertitik (bentuk pendek seperti `127.1` ditolak)")
    assert(ip::parse(" 1.2.3.4").is_err())
    assert(ip::parse("1.2.3.4.").is_err())
    assert(ip::parse("١.2.3.4").is_err())
    assert_eq(galat("fe80::1%eth0"), "alamat IP `fe80::1%eth0`: zona (`%..`) tidak didukung — artinya bergantung pada mesin yang membaca")
    assert_eq(galat("1::2::3"), "alamat IP `1::2::3`: `::` cuma boleh sekali")
    assert_eq(galat("1:2:3:4:5:6:7::8"), "alamat IP `1:2:3:4:5:6:7::8`: `::` harus mewakili paling sedikit satu kelompok nol")
    assert_eq(galat("12345::"), "alamat IP `12345::`: kelompok `12345` bukan 1 sampai 4 digit heksadesimal")
    assert(ip::parse("[::1]").is_err())
    assert(ip::parse("1.2.3.4::").is_err())
    assert(ip::parse("::ffff:01.2.3.4").is_err())
    assert(ip::parse("").is_err())
}

fn test_cidr() {
    let j = ip::cidr("10.0.0.0/8").unwrap()
    assert(ip::berisi(j, p("10.255.1.2")))
    assert(!ip::berisi(j, p("11.0.0.1")))
    assert(!ip::berisi(j, p("::ffff:10.0.0.1")))
    assert(ip::berisi(ip::cidr("0.0.0.0/0").unwrap(), p("8.8.8.8")))
    assert(ip::berisi(ip::cidr("2001:db8::/32").unwrap(), p("2001:db8:ffff::1")))
    assert(!ip::berisi(ip::cidr("2001:db8::/33").unwrap(), p("2001:db8:ffff::1")))
    assert_eq(ip::cidr("10.0.0.1/8").unwrap_err(), "jaringan `10.0.0.1/8` punya bit host yang terisi — maksudnya 10.0.0.0/8?")
    assert_eq(ip::cidr("10.0.0.0/33").unwrap_err(), "prefiks /33 di atas 32 untuk IPv4")
    assert_eq(ip::cidr("10.0.0.0/08").unwrap_err(), "prefiks `08` bukan bilangan desimal tanpa nol di depan")
    assert(ip::cidr("10.0.0.0").is_err())
}

fn test_golongan_dan_bypass_ssrf() {
    assert_eq(ip::golongan(p("127.0.0.1")), "loopback")
    assert_eq(ip::golongan(p("::ffff:127.0.0.1")), "loopback")
    assert_eq(ip::golongan(p("::ffff:7f00:1")), "loopback")
    assert_eq(ip::golongan(p("169.254.169.254")), "link-local")
    assert_eq(ip::golongan(p("::ffff:169.254.169.254")), "link-local")
    assert_eq(ip::golongan(p("100.64.0.1")), "cgnat")
    assert_eq(ip::golongan(p("fd00::1")), "privat")
    assert_eq(ip::golongan(p("::")), "tak-ditentukan")
    assert_eq(ip::golongan(p("255.255.255.255")), "siaran")
    assert(ip::publik(p("8.8.8.8")))
    assert(ip::publik(p("2606:4700::1111")))
    assert(!ip::publik(p("::1")))
}
