package main
import "std/tanggal"

fn w(s) {
    match tanggal::parse_iso(s) {
        Ok(v) => { return v }
        Err(e) => { panik("tak terduga: " + e) }
    }
}

fn galat(s) {
    match tanggal::parse_iso(s) {
        Ok(v) => { panik(«harusnya Err: ${v}») }
        Err(e) => { return e }
    }
}

fn test_unix_bolak_balik() {
    assert_eq(tanggal::ke_unix(w("2026-11-02T13:05:09+07:00")), 1793599509)
    assert_eq(tanggal::ke_unix(w("0001-01-01T00:00:00Z")), -62135596800)
    assert_eq(tanggal::ke_unix(w("9999-12-31T23:59:59Z")), 253402300799)
    assert_eq(tanggal::ke_unix(w("1969-12-31T23:59:59Z")), -1)
    assert_eq(tanggal::ke_unix(tanggal::dari(2000, 2, 29).unwrap()), 951782400)
    assert_eq(tanggal::format_iso(tanggal::dari_unix(-1, 0).unwrap()), "1969-12-31T23:59:59Z")
    assert_eq(tanggal::format_iso(tanggal::dari_unix(1700000000, -330).unwrap()), "2023-11-14T16:43:20-05:30")
    assert_eq(tanggal::format_iso(tanggal::dari_unix_ms(-1, 0).unwrap()), "1969-12-31T23:59:59.999Z")
    assert(tanggal::dari_unix(253402300800, 0).is_err())
    for _, s in [-62135596800, -1, 0, 1, 951782400, 1793599509, 253402300799] {
        assert_eq(tanggal::ke_unix(tanggal::dari_unix(s, 0).unwrap()), s)
    }
    assert_eq(tanggal::dari_unix(253402300799, 420).unwrap_err(), "cap waktu 253402300799 di luar tahun 1 sampai 9999")
}

fn test_format_dan_parse() {
    let v = w("2026-11-02T13:05:09.120+07:00")
    assert_eq(v.nano, 120000000)
    assert_eq(tanggal::format_iso(v), "2026-11-02T13:05:09.12+07:00")
    assert_eq(tanggal::format_iso(w("2026-11-02T13:05:09.000000001Z")), "2026-11-02T13:05:09.000000001Z")
    assert_eq(tanggal::format_tanggal(v), "2026-11-02")
    assert_eq(tanggal::format_panjang(v), "Senin, 2 November 2026")
    assert_eq(tanggal::format_iso(tanggal::ke_offset(v, 0).unwrap()), "2026-11-02T06:05:09.12Z")
    assert_eq(tanggal::format_tanggal(tanggal::parse_tanggal("2024-02-29").unwrap()), "2024-02-29")
}

fn test_yang_ambigu_ditolak() {
    assert_eq(galat("2026-11-02T13:05:09"), "waktu `2026-11-02T13:05:09`: zona tidak ditulis — tambahkan `Z` (UTC) atau `+07:00`")
    assert_eq(galat("2026-11-02 13:05:09Z"), "waktu `2026-11-02 13:05:09Z`: harusnya `T` di posisi 10")
    assert_eq(galat("2026-11-02t13:05:09Z"), "waktu `2026-11-02t13:05:09Z`: harusnya `T` di posisi 10")
    assert_eq(galat("2026-11-02T13:05:09z"), "waktu `2026-11-02T13:05:09z`: zona harus `Z`, `+HH:MM` atau `-HH:MM`, ketemu `z`")
    assert_eq(galat("2026-11-02T13:05:09-00:00"), "waktu `2026-11-02T13:05:09-00:00`: zona `-00:00` (offset tak diketahui) tidak didukung — tulis `Z`")
    assert_eq(galat("2026-11-02T23:59:60Z"), "waktu `2026-11-02T23:59:60Z`: detik 60 di luar 0 sampai 59 (detik kabisat tidak didukung)")
    assert_eq(galat("2026-02-29T00:00:00Z"), "waktu `2026-02-29T00:00:00Z`: tanggal 29 Februari 2026 tidak ada (bulan itu 28 hari)")
    assert_eq(galat("2026-11-0٢T00:00:00Z"), "waktu `2026-11-0٢T00:00:00Z`: tanggal harus angka ASCII, ketemu `٢`")
    assert_eq(galat("2026-11-02T13:05:09.Z"), "waktu `2026-11-02T13:05:09.Z`: titik pecahan tanpa digit")
    assert_eq(galat("2026-11-02T13:05:09.1234567891Z"), "waktu `2026-11-02T13:05:09.1234567891Z`: pecahan detik lebih dari 9 digit")
    assert_eq(galat("2026-11-02T13:05:09Z "), "waktu `2026-11-02T13:05:09Z `: ada teks berlebih mulai posisi 20")
    assert_eq(galat("2026-11-02T13:05:09+24:00"), "waktu `2026-11-02T13:05:09+24:00`: zona `+24:00` di luar ±23:59")
    assert_eq(galat("0000-01-01T00:00:00Z"), "waktu `0000-01-01T00:00:00Z`: tahun 0 di luar 1 sampai 9999")
    assert_eq(galat("2026-11-02T13:05\n:09Z"), "waktu (21 karakter, memuat karakter kendali): harusnya `:` di posisi 16")
    assert_eq(galat(str::repeat("9", 100000)), "waktu (100000 karakter) terlalu panjang untuk RFC 3339")
    assert_eq(tanggal::parse_tanggal("2026-1-02").unwrap_err(), "tanggal `2026-1-02` harus berbentuk YYYY-MM-DD")
}

fn test_kalender() {
    assert(tanggal::kabisat(2000))
    assert(!tanggal::kabisat(1900))
    assert(tanggal::kabisat(2024))
    assert_eq(tanggal::jumlah_hari(2023, 2), 28)
    assert_eq(tanggal::hari_pekan(tanggal::dari(2026, 11, 2).unwrap()), 1)
    assert_eq(tanggal::hari_pekan(tanggal::dari(1900, 3, 1).unwrap()), 4)
    assert_eq(tanggal::hari_pekan(tanggal::dari(1, 1, 1).unwrap()), 1)
    assert_eq(tanggal::nama_hari(tanggal::dari(2026, 11, 8).unwrap()), "Minggu")
    assert_eq(tanggal::hari_ke(tanggal::dari(2024, 12, 31).unwrap()), 366)
    assert_eq(tanggal::hari_ke(tanggal::dari(2023, 1, 1).unwrap()), 1)
    assert(tanggal::dari(2023, 13, 1).is_err())
    assert(tanggal::waktu(2023, 1, 1, 24, 0, 0, 0).is_err())
}

fn test_aritmetika() {
    let a = w("2024-01-31T10:00:00+07:00")
    assert_eq(tanggal::tambah_bulan(a, 1).unwrap_err(), "tanggal 31 Februari 2024 tidak ada (bulan itu 29 hari) — `tanggal::tambah_bulan_jepit` memakai hari terakhir bulan itu")
    assert_eq(tanggal::format_iso(tanggal::tambah_bulan_jepit(a, 1).unwrap()), "2024-02-29T10:00:00+07:00")
    assert(tanggal::tambah_bulan(a, -2).is_err())
    assert_eq(tanggal::format_iso(tanggal::tambah_bulan(a, -1).unwrap()), "2023-12-31T10:00:00+07:00")
    assert_eq(tanggal::format_iso(tanggal::tambah_bulan(a, 12).unwrap()), "2025-01-31T10:00:00+07:00")
    assert_eq(tanggal::format_iso(tanggal::tambah_hari(a, 30).unwrap()), "2024-03-01T10:00:00+07:00")
    assert_eq(tanggal::format_iso(tanggal::tambah_detik(a, -36001).unwrap()), "2024-01-30T23:59:59+07:00")
    let b = w("2024-01-31T03:00:00Z")
    assert_eq(tanggal::banding(a, b), 0)
    assert_eq(tanggal::selisih_detik(a, w("2024-02-01T03:00:00Z")), 86400)
    assert_eq(tanggal::banding(w("2024-01-01T00:00:00.5Z"), w("2024-01-01T00:00:00Z")), 1)
    assert(tanggal::tambah_hari(w("9999-12-31T00:00:00Z"), 1).is_err())
}

fn test_sekarang() {
    let s = tanggal::sekarang(420).unwrap()
    assert(s.tahun >= 2026)
    assert_eq(s.offset, 420)
}
