package std_base32

// Base32 RFC 4648 (`A-Z2-7`, padding `=`) yang ketat: huruf kecil, spasi, `=` di tengah, jumlah `=` yang mustahil
// dan bit sisa yang bukan nol ditolak — satu isi punya satu ejaan, jadi dua pembaca tidak bisa membaca satu teks
// sebagai dua isi berbeda (kelas CVE-2026-3446 di base64 Python).

const _ABJAD = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"

fn _byte(x) {
    if typeof(x) == "string" { return str::bytes(x) }
    if typeof(x) != "array" { panik(«base32::encode: butuh teks atau array byte, dapat `${typeof(x)}`») }
    for i, b in x {
        if typeof(b) != "int" || b < 0 || b > 255 { panik(«base32::encode: isi ke-${i} bukan byte 0 sampai 255») }
    }
    return x
}

/// Sandikan teks (byte UTF-8-nya) atau array byte jadi base32 berpadding.
pub fn encode(x) {
    let b = _byte(x)
    var keluar = ""
    var i = 0
    while i < len(b) {
        let blok = b[i:math::min(i + 5, len(b))]
        var n = 0
        for _, v in blok { n = n * 256 + v }
        let bit = len(blok) * 8
        let huruf = (bit + 4) / 5
        n = n * (1 << (huruf * 5 - bit))
        var s = ""
        for _, k in range(huruf) {
            let d = n % 32
            s = _ABJAD[d:d + 1] + s
            n = n / 32
        }
        keluar = keluar + s + str::repeat("=", 8 - huruf)
        i += 5
    }
    return keluar
}

/// Kembalikan base32 jadi array byte; `Err` yang menyebut posisinya kalau bentuknya tidak kanonik.
pub fn decode_bytes(s) {
    if len(s) % 8 != 0 {
        let r = len(s) <= 40 $ "" : « (${len(s)} karakter)»
        return Err(«base32: panjang ${len(s)}${r} bukan kelipatan 8 — padding `=` wajib»)
    }
    let cs = arr::map(str::chars(s), |r| str(r))
    var hasil = []
    var i = 0
    while i < len(cs) {
        var nilai = []
        var pad = 0
        for _, k in range(8) {
            let c = cs[i + k]
            if c == "=" {
                pad += 1
            } else {
                if pad > 0 { return Err(«base32: `=` di posisi ${i + k - pad} diikuti huruf — padding cuma boleh di ujung») }
                match str::index_of(_ABJAD, c) {
                    Some(d) => { nilai = arr::push(nilai, d) }
                    None => {
                        let lain = (c >= "a" && c <= "z") $ " (huruf kecil tidak diterima)" : ""
                        return Err(«base32: karakter di posisi ${i + k} bukan A-Z/2-7${lain}»)
                    }
                }
            }
        }
        if pad > 0 && i + 8 < len(cs) { return Err(«base32: padding di posisi ${i + 8 - pad} sebelum akhir data») }
        let byte = match pad { 0 => 5, 1 => 4, 3 => 3, 4 => 2, 6 => 1, _ => -1 }
        if byte < 0 { return Err(«base32: ${pad} tanda `=` di satu blok tidak mungkin (yang sah: 0, 1, 3, 4, 6)») }
        var n = 0
        for _, d in nilai { n = n * 32 + d }
        let sisa = len(nilai) * 5 - byte * 8
        if n % (1 << sisa) != 0 { return Err(«base32: bit sisa di blok mulai posisi ${i} bukan nol — ejaan kedua dari byte yang sama») }
        n = n / (1 << sisa)
        var blok = []
        for _, k in range(byte) {
            blok = arr::push(blok, n % 256)
            n = n / 256
        }
        hasil = arr::concat(hasil, arr::reverse(blok))
        i += 8
    }
    return Ok(hasil)
}
