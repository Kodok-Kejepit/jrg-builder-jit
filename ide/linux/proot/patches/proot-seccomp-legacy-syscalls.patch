+/**
+ * Woksole: give a child created by a rewritten fork/vfork (see
+ * tracee/seccomp.c) back the argument registers its parent had before
+ * the rewrite.  The syscall ABI preserves them, so compiled code may
+ * rely on them after fork() returns 0.  @child must be ptrace-stopped.
+ */
+void restore_child_fork_args(Tracee *child)
+{
+	if (!child->restore_fork_args)
+		return;
+	child->restore_fork_args = false;
+
+	if (fetch_regs(child) < 0)
+		return;
+
+	REG(child, CURRENT, SYSARG_1) = REG(child, ORIGINAL_SECCOMP_REWRITE, SYSARG_1);
+	REG(child, CURRENT, SYSARG_2) = REG(child, ORIGINAL_SECCOMP_REWRITE, SYSARG_2);
+	REG(child, CURRENT, SYSARG_3) = REG(child, ORIGINAL_SECCOMP_REWRITE, SYSARG_3);
+	REG(child, CURRENT, SYSARG_4) = REG(child, ORIGINAL_SECCOMP_REWRITE, SYSARG_4);
+	REG(child, CURRENT, SYSARG_5) = REG(child, ORIGINAL_SECCOMP_REWRITE, SYSARG_5);
+	REG(child, CURRENT, SYSARG_6) = REG(child, ORIGINAL_SECCOMP_REWRITE, SYSARG_6);
+
+	child->restore_original_regs = false;
+	child->_regs_were_changed = true;
+	(void) push_specific_regs(child, false);
+	child->_regs_were_changed = false;
+}
+
