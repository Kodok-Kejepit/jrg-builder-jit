#!/bin/sh
# sudo JRG IDE: di Linux ini kamu sudah root, jadi perintahnya langsung dijalankan. Paket sudo asli (apt) dipakai kalau ada.
[ -x /usr/bin/sudo ] && exec /usr/bin/sudo "$@"
while [ $# -gt 0 ]; do
    case "$1" in
        -u|-g|-C|-D|-h|-p|-r|-t|-U) shift 2 ;;
        --) shift; break ;;
        -*) shift ;;
        *) break ;;
    esac
done
[ $# -gt 0 ] || { echo "pakai: sudo <perintah>" >&2; exit 1; }
exec "$@"
